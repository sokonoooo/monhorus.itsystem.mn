{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "rootDir": "./src",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "./dist/cjs"
  },
  "include": ["src/**/*.ts"],
  // Tests are colocated with the source they cover, as they are in both apps. They are
  // excluded from the build so `dist` carries the package and nothing else — a `.test.js`
  // shipped to the backend and the web app would be dead weight in both.
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
