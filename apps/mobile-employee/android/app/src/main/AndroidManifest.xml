<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Declared in the main source set, not just debug/profile.

         The Flutter template ships INTERNET only in the debug and profile manifests,
         where it exists for the tool's own hot-reload channel. That is enough for an
         app that never calls out, but every screen here is backed by the API, so a
         release build without it has no network at all: Android denies the socket and
         Dio surfaces it as a connection error, which this app renders as
         "сүлжээний алдаа" on a login that could never have succeeded. It fails only in
         release, so it survives any amount of debug testing — and `flutter analyze`,
         `flutter test` and `flutter build apk` all pass regardless, since a missing
         runtime permission is not a compile-time fact. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!--
        Android 13 (API 33) and above will not show a notification until the user grants
        this. Below 33 it is ignored, so it is declared unconditionally rather than gated on
        the target SDK - which this module inherits from the Flutter SDK rather than pinning,
        so it can rise to 33 without anybody here choosing it.

        PushMessaging.start() is what raises the dialog. A refusal is not fatal: the token is
        still registered, because the user may enable notifications later in system settings
        and nothing would re-register at that point.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="Monhorus Employee"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!--
            Where a message with no explicit channel lands. Must match _channelId in
            lib/core/push/push_messaging.dart: Android silently discards a notification
            whose channel does not exist, so a drift between these two is invisible until
            somebody reports that push "does not work".
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="monhorus_default" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
