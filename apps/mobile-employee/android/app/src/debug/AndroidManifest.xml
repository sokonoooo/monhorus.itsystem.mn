<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- The dev backend is served over plain HTTP at http://10.0.2.2:4000 (see
         AppConfig), and cleartext traffic has been blocked by default since
         targetSdk 28. Without this the Android build cannot reach the API at all and
         every request fails as a connection error.

         Debug-only on purpose: scoped to this source set, so a release build keeps
         the platform default and cannot silently ship a cleartext client. A real
         deployment talks to an HTTPS host and needs no exemption. iOS has the
         equivalent already, as NSAllowsLocalNetworking in Info.plist. -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
