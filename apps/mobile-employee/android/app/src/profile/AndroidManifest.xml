<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Same cleartext exemption the debug source set carries, for the same reason:
         a profile build is a development build and still points at the plain-HTTP dev
         backend, so without this a performance run cannot reach the API and measures
         nothing but failing requests. The release source set is deliberately still
         left at the platform default. -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
