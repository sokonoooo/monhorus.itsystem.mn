# Loaded automatically by `vite build` (mode=production). Committed on purpose — see the
# .gitignore exception next to the `.env.*` rule.
#
# Without this file the only thing standing between production and a bundle that talks to
# localhost is whoever runs the build remembering to set VITE_API_BASE_URL on the command
# line. The origin is resolved at BUILD time, so getting it wrong produces a bundle that
# compiles, deploys and serves perfectly while every request goes to the developer's own
# machine — there is no runtime configuration to correct it afterwards.
#
# Nothing secret belongs here. Everything Vite inlines ships to the browser in clear text.
VITE_API_BASE_URL=https://monhorus.itsystem.mn/api/v1
