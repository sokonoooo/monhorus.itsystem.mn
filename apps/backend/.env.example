# ---------------------------------------------------------------------------
# Monhorus backend environment
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# --- Database --------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/monhorus

# --- JWT -------------------------------------------------------------------
# Generate each with a DIFFERENT value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-48-random-bytes-minimum-32-characters-long
JWT_REFRESH_SECRET=replace-me-a-DIFFERENT-48-random-bytes-value-here
JWT_ACCESS_TTL=15m
JWT_ISSUER=monhorus
JWT_AUDIENCE=monhorus-clients

# Refresh tokens are stored as SHA-256 digests and are revocable.
# 30 days keeps a field technician usable across a long offline stretch.
REFRESH_TOKEN_TTL_DAYS=30

# --- Login throttling ------------------------------------------------------
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# Per-IP ceilings for /auth/login and /auth/refresh, per fifteen minutes. Leave unset in
# every real deployment: the defaults are 10 and 120 in production, 100 and 1000 elsewhere.
# Exists so the test suite, which is one IP signing in hundreds of times, is not limited by
# a policy aimed at brute force.
# RATE_LIMIT_CREDENTIAL_MAX=
# RATE_LIMIT_REFRESH_MAX=

# --- HTTP ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173

# --- Localisation ----------------------------------------------------------
APP_TIMEZONE=Asia/Ulaanbaatar

# --- First head administrator ----------------------------------------------
# Consumed once by: npm run bootstrap:admin --workspace @monhorus/backend
# Clear BOOTSTRAP_ADMIN_PASSWORD immediately afterwards.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# --- Development seed ------------------------------------------------------
# Password for the technician logins created by:
#   npm run seed:dev --workspace @monhorus/backend
# Those accounts are what the employee mobile app signs in with; each one is linked to a
# seeded employee card, which is what GET /employees/me needs. Minimum 10 characters.
# Leave unset to accept the default, which is Monhorus.dev2026.
# The seed refuses to run with NODE_ENV=production, so this never reaches a deployment.
# SEED_DEV_PASSWORD=

# --- Password reset over email ---------------------------------------------
# Where a mailed reset link points. The backend cannot derive this from a request,
# so it must be set to the public address of the web app in any real deployment.
APP_WEB_BASE_URL=http://localhost:5173

# How long a reset link stays usable, in minutes. Single-use regardless.
PASSWORD_RESET_TTL_MINUTES=60

# SMTP. With SMTP_HOST unset the server LOGS the reset link instead of mailing it in
# development, and REFUSES TO SEND in production rather than logging a live token. That
# is what keeps local development and the test suite off the network. Set these to send
# real mail. User and pass may be omitted for an open internal relay.
#
# Gmail specifics, since that is the chosen transport:
#
#   SMTP_PASS is a 16-character *App Password*, not the account password. Google only
#   offers App Passwords on accounts with 2-Step Verification switched on, and a normal
#   password will be rejected outright.
#
#   Gmail REWRITES the From header. It sends as the authenticated SMTP_USER unless that
#   account has verified the MAIL_FROM address under Settings > Accounts > "Send mail
#   as". Set MAIL_FROM to the Gmail address itself unless you have completed that
#   verification, otherwise the header and the envelope disagree and SPF fails — which
#   lands a password-reset mail in spam, the one place it must never go.
#
#   Free Gmail caps at roughly 500 recipients per day, Workspace at 2000. Password reset
#   is the only mail this backend sends, so that ceiling is not a practical limit today.
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Monhorus <no-reply@monhorus.itsystem.mn>

# --- Push notifications (Firebase Cloud Messaging) --------------------------
# Android push only; iOS is deliberately out of scope, so no APNs key is needed.
# With FIREBASE_PROJECT_ID unset the backend records notifications in the database
# exactly as before and sends no push, which is how development and the tests run.
#
# All three come from one Firebase service-account JSON (Project settings > Service
# accounts > Generate new private key). Do NOT commit that file — .gitignore blocks
# serviceAccount*.json. FIREBASE_PRIVATE_KEY contains literal \n escapes and must stay
# in double quotes on one line.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
